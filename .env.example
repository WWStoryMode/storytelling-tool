# Copy to .env and fill in. .env is git-ignored.
PORT=5049
# Public ngrok URL the hub calls; never localhost when registering
PUBLIC_URL=https://example.ngrok-free.app
# A long random string you choose (openssl rand -hex 24). It goes into storytelling.json, and the hub checks /api/send calls against it
HUB_SECRET=
# Tool Hub address for /api/send, from the organiser; a bare host gets https:// added
HUB_URL=
# Optional: record story commands, reactions and redactions here for `npm run replay`; ordinary chat is never written
EVENT_LOG=
